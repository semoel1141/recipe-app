# ===============================================
#  .gitignore ראשי (root) - חל על כל הפרויקט
#  יש בנוסף .gitignore נפרד ב-backend/ וב-frontend/
# ===============================================

# --- סודות: הדבר הקריטי ביותר בקובץ הזה ---
# .env מכיל את הסיסמה למסד הנתונים, את סוד ה-JWT ואת מפתח ה-API.
# הוא לעולם לא נכנס ל-git. הדפוסים למטה תופסים אותו בכל תיקייה.
.env
.env.*
!.env.example
*.pem
*.key

# --- תלויות (כבד מאוד, נבנה מחדש מ-package.json) ---
node_modules/

# --- תוצרי build (נבנים מחדש בשרת הפריסה) ---
dist/
build/
.vite/

# --- לוגים ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# --- קבצים שנוצרים בזמן ריצה ---
# תמונות AI שנשמרות לדיסק - תוכן נגזר, לא קוד מקור
uploads/
coverage/
.cache/
tmp/

# --- כלי עריכה ומערכת הפעלה ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.sw?

# --- הגדרות מקומיות של Claude Code ---
.claude/
