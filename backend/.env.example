# העתיקו קובץ זה ל-.env ומלאו את הערכים האמיתיים.
# הקובץ .env עצמו לא נכנס ל-git (ראו .gitignore).

# הפורט שעליו השרת מאזין
PORT=5000

# מחרוזת החיבור ל-MongoDB Atlas (חובה)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# סוד לחתימת טוקני JWT (חובה) - מחרוזת אקראית של 32 תווים לפחות.
# ליצירה: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# מפתח Gemini ליצירת מתכונים - https://aistudio.google.com/apikey
# בלעדיו השרת יעלה כרגיל, אבל נתיבי ה-AI יחזירו 503.
GEMINI_API_KEY=

# האם לייצר תמונות ב-AI ולשמור אותן לדיסק (ברירת מחדל: false).
#
# השאירו כבוי בפריסה על Render/Railway בתוכנית חינמית: מערכת הקבצים שם
# נמחקת בכל פריסה, ולכן תמונות שנוצרו ב-AI ייעלמו כעבור כמה שעות.
# כשכבוי, התמונות מגיעות ממקורות חיצוניים יציבים (ראו config/recipeImages.js)
# ויצירת המתכונים עצמה ממשיכה לעבוד רגיל.
#
# הפעילו רק אם יש אחסון קבוע (דיסק בתשלום, או Cloudinary וכדומה).
AI_IMAGE_GENERATION=false

# האם להפעיל את חיפוש המסעדות "מי מכין לי את זה?" (ברירת מחדל: false).
#
# הפיצ'ר נשען על Overpass API של OpenStreetMap - חינמי לגמרי, בלי מפתח
# ובלי חשבון חיוב. בתמורה, איכות הנתונים בישראל מוגבלת (נמדד ביולי 2026):
# במרכז ת"א רק ל-28% מהמסעדות יש טלפון ב-OSM, ובבאר שבע ל-9%.
#
# לכן הממשק מציג טלפון רק כשהוא קיים, ותמיד מצרף קישור למפות Google -
# שם הטלפון ושעות הפתיחה זמינים תמיד, גם בלי מפתח API.
#
# Overpass הוא שירות התנדבותי עם מדיניות שימוש הוגן. אל תפעילו את הדגל
# בלי שהקאש במונגו עובד (מודל PlacesCache) - בלעדיו כל צפייה במתכון
# הופכת לשאילתה חדשה מולו.
RESTAURANT_FINDER=false

# כתובות שמורשות לפנות ל-API (CORS). אפשר כמה, מופרדות בפסיק.
CLIENT_URL=http://localhost:5173
